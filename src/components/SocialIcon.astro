---
interface Props {
  name: 'facebook' | 'instagram' | 'youtube';
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;
---

{name === 'facebook' && (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M14 9.5V7.5c0-.83.67-1.5 1.5-1.5H17V3h-2.5A4 4 0 0 0 10.5 7v2.5H8V13h2.5v8h3.5v-8H17l.5-3.5h-3.5Z" />
  </svg>
)}
{name === 'instagram' && (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17" cy="7" r="0.6" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'youtube' && (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="2.5" y="6" width="19" height="12" rx="4" />
    <path d="M10.5 9.5 15 12l-4.5 2.5v-5Z" fill="currentColor" stroke="none" />
  </svg>
)}
