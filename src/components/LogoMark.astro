---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
const rays = Array.from({ length: 12 }, (_, i) => i * 30);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  class={className}
  aria-hidden="true"
>
  <g stroke="var(--accent-500)" stroke-width="1.4" stroke-linecap="round">
    {rays.map((deg) => (
      <line
        x1="20"
        y1="3"
        x2="20"
        y2="6.5"
        transform={`rotate(${deg} 20 20)`}
        opacity="0.85"
      />
    ))}
  </g>
  <circle cx="20" cy="20" r="13.5" fill="none" stroke="var(--accent-500)" stroke-width="1.6" />
  <text
    x="20"
    y="27"
    text-anchor="middle"
    font-size="17"
    fill="var(--accent-500)"
    font-family="'Noto Sans Devanagari', 'Nirmala UI', sans-serif"
  >ॐ</text>
</svg>
