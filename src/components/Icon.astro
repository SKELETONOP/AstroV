---
import {
  Compass,
  Sparkle,
  ShieldCheck,
  Heart,
  HeartHandshake,
  Users,
  Leaf,
  Phone,
  MessageCircle,
  Menu,
  X,
  ChevronDown,
  ChevronRight,
  ChevronLeft,
  MapPin,
  Mail,
  Clock,
  Star,
  Plus,
  Minus,
  ArrowRight,
  Quote,
  CircleCheck,
  Sparkles,
  ScrollText,
  Landmark,
  Calendar,
  TrendingUp,
} from '@lucide/astro';

const icons = {
  Compass,
  Sparkle,
  ShieldCheck,
  Heart,
  HeartHandshake,
  Users,
  Leaf,
  Phone,
  MessageCircle,
  Menu,
  X,
  ChevronDown,
  ChevronRight,
  ChevronLeft,
  MapPin,
  Mail,
  Clock,
  Star,
  Plus,
  Minus,
  ArrowRight,
  Quote,
  CheckCircle2: CircleCheck,
  Sparkles,
  ScrollText,
  Landmark,
  Calendar,
  TrendingUp,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { name, size = 20, class: className, strokeWidth = 1.75, ...rest } = Astro.props;
const Cmp = icons[name] ?? Star;
---

<Cmp size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" {...rest} />
