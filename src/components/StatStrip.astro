---
interface Stat {
  number: string;
  label: string;
}

interface Props {
  stats: Stat[];
  class?: string;
}

const { stats, class: className = '' } = Astro.props;
---

<div class={`grid grid-cols-2 gap-6 sm:grid-cols-4 ${className}`}>
  {stats.map((stat) => (
    <div class="text-center">
      <p class="font-display text-3xl font-extrabold text-accent-700 sm:text-4xl">{stat.number}</p>
      <p class="mt-1 text-sm text-neutral-600">{stat.label}</p>
    </div>
  ))}
</div>
