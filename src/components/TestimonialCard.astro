---
import Icon from './Icon.astro';

interface Props {
  name: string;
  location: string;
  quote: string;
  rating?: number;
  class?: string;
}

const { name, location, quote, rating = 5, class: className = '' } = Astro.props;
const initials = name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<figure class={`flex h-full flex-col rounded-xl border border-neutral-200 bg-surface p-6 shadow-soft ${className}`}>
  <Icon name="Quote" size={28} class="text-accent-200" />
  <blockquote class="mt-3 flex-1 text-sm leading-6 text-neutral-700">
    “{quote}”
  </blockquote>
  <div class="mt-3 flex items-center gap-1" aria-label={`Rated ${rating} out of 5`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <Icon name="Star" size={14} class={i < rating ? 'fill-accent-500 text-accent-500' : 'text-neutral-300'} />
    ))}
  </div>
  <figcaption class="mt-4 flex items-center gap-3 border-t border-neutral-100 pt-4">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-100 text-sm font-semibold text-accent-700">
      {initials}
    </span>
    <span>
      <span class="block text-sm font-semibold text-neutral-900">{name}</span>
      <span class="block text-xs text-neutral-500">{location}</span>
    </span>
  </figcaption>
</figure>
