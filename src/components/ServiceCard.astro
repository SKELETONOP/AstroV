---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import site from '../data/site.json';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  slug: string;
  phone?: string;
  whatsappLink?: string;
  class?: string;
}

const {
  icon,
  title,
  description,
  slug,
  phone = site.phone,
  whatsappLink = `https://wa.me/${site.whatsapp}`,
  class: className = '',
} = Astro.props;
---

<article class={`flex h-full flex-col rounded-xl border border-neutral-200 bg-surface p-6 shadow-soft transition-shadow hover:shadow-card ${className}`}>
  <div class="flex h-12 w-12 items-center justify-center rounded-full border border-accent-500/40 bg-accent-50 text-accent-600">
    <Icon name={icon} size={22} />
  </div>
  <h3 class="mt-4 text-lg font-semibold text-neutral-900">
    <a href={`/services/${slug}`} class="hover:text-accent-700">{title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-neutral-600">{description}</p>
  <div class="mt-5 flex items-center gap-4 border-t border-neutral-100 pt-4 text-sm">
    <a href={`/services/${slug}`} class="font-semibold text-accent-700 hover:text-accent-800">
      Learn more
    </a>
    <span class="text-neutral-300" aria-hidden="true">|</span>
    <a href={`tel:${phone.replace(/\s+/g, '')}`} class="flex items-center gap-1 text-neutral-600 hover:text-accent-700">
      <Icon name="Phone" size={14} />
      Call
    </a>
    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-neutral-600 hover:text-accent-700">
      <Icon name="MessageCircle" size={14} />
      WhatsApp
    </a>
  </div>
</article>
