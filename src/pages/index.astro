---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Carousel from '../components/Carousel.astro';
import StatStrip from '../components/StatStrip.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import servicesData from '../data/services.json';

const allServices = servicesData.categories.flatMap((cat: any) =>
  cat.items.map((item: any) => ({ ...item, category: cat.name }))
);

const stats = [
  { number: '20+', label: 'Years of Experience' },
  { number: '15,000+', label: 'Consultations Given' },
  { number: '40+', label: 'Countries Reached' },
  { number: '4.9/5', label: 'Average Client Rating' },
];

const testimonials = [
  {
    name: 'Ritika Sharma',
    location: 'Delhi, India',
    quote:
      'Vikesh ji explained my chart in a way I actually understood. The timing he gave for my job change turned out to be exactly right.',
    rating: 5,
  },
  {
    name: 'Amit Verma',
    location: 'Toronto, Canada',
    quote:
      'I was skeptical at first, but the consultation over video call was calm, clear and never felt like a sales pitch.',
    rating: 5,
  },
  {
    name: 'Farah Al-Sayed',
    location: 'Dubai, UAE',
    quote:
      'The family guidance around our marriage was practical, not just spiritual. Things genuinely improved within weeks.',
    rating: 5,
  },
  {
    name: 'Priya Nair',
    location: 'Bengaluru, India',
    quote:
      'Straightforward, respectful, and honest about what a remedy could and could not do. That honesty is rare.',
    rating: 4,
  },
];

const faqs = [
  {
    question: 'How does an online consultation work?',
    answer:
      'You share your birth details in advance, and we connect over a phone or video call at your scheduled time. You will receive clear guidance and, if relevant, a simple remedy to follow.',
  },
  {
    question: 'How soon can I expect results from a remedy?',
    answer:
      'This varies by situation, but most clients notice a shift within a few weeks of consistently following a prescribed remedy. You will be given a realistic timeline during your consultation.',
  },
  {
    question: 'Is my information kept confidential?',
    answer:
      'Yes. Everything shared during a consultation, including birth details and personal circumstances, is kept strictly confidential.',
  },
  {
    question: 'Do you offer consultations outside India?',
    answer:
      'Yes, consultations are available worldwide over phone, WhatsApp and video call, including for clients in the UK, Canada, Australia, the Gulf and Singapore.',
  },
];
---

<BaseLayout
  title="Astro Vikesh Kumar — Astrology & Spiritual Consultation in Delhi"
  description="Trusted astrology, vashikaran, black magic removal and love problem consultations from Pandit Vikesh Kumar. 20+ years of experience, available worldwide."
>
  <!-- Hero -->
  <section class="relative h-[100vh] overflow-hidden bg-neutral-50 lg:h-auto">
    <!--
      Full-bleed background photo slot — separate crops for mobile (portrait) and
      desktop (landscape). Drop files at:
        public/images/hero-bg-mobile.png  (used below the lg breakpoint)
        public/images/hero-bg.png         (used at lg and above)
      With no file present this simply falls back to the plain navy background.
    -->
    <div class="absolute inset-0 bg-[url('/images/hero-bg-mobile.png')] bg-cover bg-[right_bottom] bg-no-repeat lg:bg-[url('/images/hero-bg.png')] lg:bg-[center_top]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-50/10 via-neutral-50/45 to-neutral-50/85 lg:hidden"></div>
    <div class="absolute inset-0 hidden from-neutral-50 via-neutral-50/85 to-neutral-50/20 lg:block"></div>

    <!--
      Mobile: flex column + justify-between pins the text block to the top and the
      trust-badge strip to the bottom of the fixed-height section. Reset to a plain
      block at lg so the desktop layout (unchanged) flows naturally as before.
    -->
    <div class="container-page relative z-10 flex h-[90vh] flex-col justify-between py-6 lg:block lg:h-auto lg:py-9">
      <div class="max-w-xs sm:max-w-xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-accent-500/40 bg-accent-50 px-3 py-1 text-sm font-medium text-accent-600">
          <Icon name="Sparkle" size={16} />
          Trusted guidance since 2004
        </p>

        <h1 class="mt-4 font-display text-2xl font-extrabold leading-tight text-neutral-900 sm:mt-6 sm:text-5xl lg:text-6xl">
          Clarity for life's hardest questions,{' '}
          <span class="text-accent-600">grounded in your own chart.</span>
        </h1>

        <p class="mt-4 max-w-xl text-base leading-7 text-neutral-600 sm:mt-5 sm:text-lg">
          Astro Vikesh Kumar offers honest, practical astrology and spiritual guidance on love,
          marriage, family and career — available in person in Delhi or online, worldwide.
        </p>

        <div class="mt-6 flex flex-row gap-2 sm:mt-8 sm:gap-3">
          <Button href="/contact" variant="primary" size="sm" class="sm:px-6 sm:py-3.5 sm:text-lg">
            <Icon name="Calendar" size={18} />
            <span class="lg:hidden">Consult</span>
            <span class="hidden lg:inline">Book a Consultation</span>
            <Icon name="ArrowRight" size={18} />
          </Button>
          <Button href="#services" variant="secondary" size="sm" class="sm:px-6 sm:py-3.5 sm:text-lg">
            <span class="lg:hidden">Services</span>
            <span class="hidden lg:inline">Explore Services</span>
            <Icon name="ArrowRight" size={18} />
          </Button>
        </div>
      </div>

      <div
        class="-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-2 scrollbar-none sm:gap-8 lg:mx-0 lg:mt-10 lg:max-w-xl lg:px-0"
        data-trust-scroll
      >
        {[
          { icon: 'ShieldCheck' as const, label: '100% Confidential', caption: 'Your Privacy Matters' },
          { icon: 'Leaf' as const, label: 'Powerful Remedies', caption: 'For Real Solutions' },
          { icon: 'Users' as const, label: 'Expert Guidance', caption: 'Backed by Experience' },
          { icon: 'TrendingUp' as const, label: 'Positive Results', caption: 'A Brighter Tomorrow' },
          { icon: 'Clock' as const, label: 'Timely Solutions', caption: 'When You Need It' },
        ].map((item) => (
          <div class="flex w-24 shrink-0 snap-start flex-col items-center text-center sm:w-28">
            <span class="flex h-12 w-12 items-center justify-center rounded-full border border-accent-500/40 bg-accent-50 text-accent-600 sm:h-14 sm:w-14">
              <Icon name={item.icon} size={22} />
            </span>
            <p class="mt-2 text-xs font-semibold text-neutral-800 sm:text-sm">{item.label}</p>
            <p class="text-[11px] text-neutral-500">{item.caption}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Intro content block -->
  <section class="border-t border-neutral-200 bg-surface py-14 lg:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-3">
      <h2 class="text-2xl font-bold text-neutral-900 lg:col-span-1">
        Guidance rooted in tradition, delivered with honesty
      </h2>
      <div class="lg:col-span-2">
        <p class="text-base leading-7 text-neutral-600">
          For over two decades, Pandit Vikesh Kumar has helped clients across India and abroad
          navigate difficult decisions in love, marriage, family and career. Every consultation
          begins with listening, not a prescribed ritual — remedies are only ever suggested when
          your chart genuinely calls for them.
        </p>
        <p class="mt-4 text-base leading-7 text-neutral-600">
          Whether you need a single, focused answer or an ongoing relationship with a trusted
          advisor, sessions are available over phone, WhatsApp, video call or in person at the
          Delhi office.
        </p>
      </div>
    </div>
  </section>

  <!-- Services carousel -->
  <section id="services" class="border-t border-neutral-200 bg-neutral-50 py-14 lg:py-20 scroll-mt-20">
    <div class="container-page">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h2 class="text-2xl font-bold text-neutral-900 sm:text-3xl">Our Services</h2>
          <p class="mt-2 max-w-xl text-neutral-600">
            Focused consultations across astrology, vashikaran, protection, love, family and
            healing.
          </p>
        </div>
      </div>
      <Carousel ariaLabel="Services carousel" class="mt-8">
        {allServices.map((service: any) => (
          <div class="w-[85%] shrink-0 snap-start sm:w-[45%] lg:w-[31%]">
            <ServiceCard
              icon={service.icon}
              title={service.title}
              description={service.summary}
              slug={service.slug}
            />
          </div>
        ))}
      </Carousel>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-t border-neutral-200 bg-surface py-14 lg:py-16">
    <div class="container-page">
      <StatStrip stats={stats} />
    </div>
  </section>

  <!-- Testimonials carousel -->
  <section class="border-t border-neutral-200 bg-neutral-50 py-14 lg:py-20">
    <div class="container-page">
      <h2 class="text-2xl font-bold text-neutral-900 sm:text-3xl">What Clients Say</h2>
      <p class="mt-2 max-w-xl text-neutral-600">
        Real feedback from consultations held in Delhi and worldwide over video and phone.
      </p>
      <Carousel ariaLabel="Testimonials carousel" class="mt-8">
        {testimonials.map((t) => (
          <div class="w-[85%] shrink-0 snap-start sm:w-[45%] lg:w-[31%]">
            <TestimonialCard name={t.name} location={t.location} quote={t.quote} rating={t.rating} />
          </div>
        ))}
      </Carousel>
    </div>
  </section>

  <!-- About / bio -->
  <section class="border-t border-neutral-200 bg-surface py-14 lg:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <img
        src="/images/about.svg"
        alt="Abstract illustration representing decades of astrological study"
        width="900"
        height="700"
        class="w-full rounded-2xl border border-neutral-200 shadow-card"
      />
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">About Pandit Vikesh Kumar</p>
        <h2 class="mt-2 text-2xl font-bold text-neutral-900 sm:text-3xl">
          Two decades of study, thousands of consultations, one consistent approach
        </h2>
        <p class="mt-4 text-base leading-7 text-neutral-600">
          Trained in traditional Vedic astrology and spiritual practice, Vikesh Kumar has spent
          more than 20 years helping clients work through relationship conflict, family pressure,
          career uncertainty and matters of health and wellbeing.
        </p>
        <p class="mt-4 text-base leading-7 text-neutral-600">
          His approach favours plain explanation over mystique — clients leave a consultation
          understanding exactly what their chart shows and why a particular remedy has been
          suggested.
        </p>
        <Button href="/about" variant="ghost" size="md" class="mt-6">
          Read the full story
          <Icon name="ArrowRight" size={16} />
        </Button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-neutral-200 bg-neutral-50 py-14 lg:py-20">
    <div class="container-page max-w-3xl">
      <h2 class="text-2xl font-bold text-neutral-900 sm:text-3xl">Frequently Asked Questions</h2>
      <p class="mt-2 text-neutral-600">Answers to the questions we hear most often.</p>
      <div class="mt-8">
        <FaqAccordion items={faqs} idPrefix="home-faq" />
      </div>
      <div class="mt-6 text-center">
        <a href="/faq" class="text-sm font-semibold text-accent-700 hover:text-accent-800">
          View all FAQs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  [data-trust-scroll]::-webkit-scrollbar {
    display: none;
  }
</style>
