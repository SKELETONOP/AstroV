---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import site from '../data/site.json';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Astro Vikesh Kumar for astrology, vashikaran, love problem and spiritual consultations. Available by phone, WhatsApp, email and online form."
>
  <section class="border-b border-neutral-200 bg-neutral-50 py-12 lg:py-16">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold text-neutral-900 sm:text-4xl">Get in Touch</h1>
      <p class="mt-4 max-w-2xl text-lg leading-7 text-neutral-600">
        Send a message and we will get back to you, usually within a few hours. For urgent
        matters, call or message on WhatsApp directly.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-5">
      <div class="space-y-6 lg:col-span-2">
        <div class="rounded-xl border border-neutral-200 bg-surface p-6 shadow-soft">
          <h2 class="text-lg font-semibold text-neutral-900">Contact Details</h2>
          <ul class="mt-4 space-y-3 text-sm text-neutral-700">
            <li class="flex items-start gap-3">
              <Icon name="MapPin" size={18} class="mt-0.5 shrink-0 text-accent-600" />
              <span>{site.address}</span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="Phone" size={18} class="shrink-0 text-accent-600" />
              <a href={site.phoneHref} class="hover:text-accent-700">{site.phone}</a>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="Mail" size={18} class="shrink-0 text-accent-600" />
              <a href={`mailto:${site.email}`} class="hover:text-accent-700">{site.email}</a>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="Clock" size={18} class="shrink-0 text-accent-600" />
              <span>{site.hours}</span>
            </li>
          </ul>
        </div>

        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 rounded-xl bg-green-600 px-5 py-3.5 text-base font-semibold text-white hover:bg-green-700"
        >
          <Icon name="MessageCircle" size={18} />
          Chat on WhatsApp
        </a>
      </div>

      <div class="lg:col-span-3">
        <div class="rounded-xl border border-neutral-200 bg-surface p-6 shadow-soft sm:p-8">
          <div data-form-success class="hidden flex-col items-center gap-3 py-10 text-center">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-success/10 text-success">
              <Icon name="CheckCircle2" size={28} />
            </span>
            <h2 class="text-xl font-semibold text-neutral-900">Message sent</h2>
            <p class="max-w-sm text-sm text-neutral-600">
              Thank you for reaching out. We will get back to you shortly, usually within a few
              hours.
            </p>
          </div>

          <div data-form-error-banner class="mb-5 hidden items-start gap-3 rounded-lg border border-danger/30 bg-danger/10 p-4 text-sm text-danger">
            <Icon name="ShieldCheck" size={18} class="mt-0.5 shrink-0" />
            <span>Something went wrong sending your message. Please try again, or contact us directly by phone or WhatsApp.</span>
          </div>

          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-5"
            data-contact-form
            novalidate
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>
                Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" />
              </label>
            </p>

            <div>
              <label for="name" class="block text-sm font-medium text-neutral-800">Full name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-1.5 w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="name-error"
              />
              <p id="name-error" class="mt-1 hidden text-sm text-danger" data-error-for="name">Please enter your name.</p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="phone" class="block text-sm font-medium text-neutral-800">Phone number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="mt-1.5 w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-200"
                  aria-describedby="phone-error"
                  placeholder="+91 98765 43210"
                />
                <p id="phone-error" class="mt-1 hidden text-sm text-danger" data-error-for="phone">Please enter a valid phone number.</p>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-neutral-800">Email address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="mt-1.5 w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-200"
                  aria-describedby="email-error"
                  placeholder="you@example.com"
                />
                <p id="email-error" class="mt-1 hidden text-sm text-danger" data-error-for="email">Please enter a valid email address.</p>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-neutral-800">Your message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="mt-1.5 w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="message-error"
                placeholder="Tell us briefly what you'd like guidance on..."
              ></textarea>
              <p id="message-error" class="mt-1 hidden text-sm text-danger" data-error-for="message">Please enter a short message.</p>
            </div>

            <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto" data-submit-button>
              Send Message
            </Button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function setupContactForm() {
    const formEl = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!formEl) return;
    const form = formEl;

    const card = form.closest('.rounded-xl');
    const successPanel = card?.querySelector<HTMLElement>('[data-form-success]');
    const errorBanner = card?.querySelector<HTMLElement>('[data-form-error-banner]');
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');

    const validators: Record<string, (value: string) => boolean> = {
      name: (v) => v.trim().length > 1,
      phone: (v) => /^[+\d][\d\s()-]{6,}$/.test(v.trim()),
      email: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()),
      message: (v) => v.trim().length > 4,
    };

    function showFieldError(field: string, show: boolean) {
      const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${field}"]`);
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      if (!input || !error) return;
      error.classList.toggle('hidden', !show);
      input.classList.toggle('border-danger', show);
      input.setAttribute('aria-invalid', String(show));
    }

    function validateForm() {
      let valid = true;
      for (const field of Object.keys(validators)) {
        const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${field}"]`);
        const value = input?.value ?? '';
        const fieldValid = validators[field](value);
        showFieldError(field, !fieldValid);
        if (!fieldValid) valid = false;
      }
      return valid;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBanner?.classList.add('hidden');

      if (!validateForm()) return;

      const formData = new FormData(form);
      submitButton?.setAttribute('disabled', 'true');
      const originalLabel = submitButton?.textContent;
      if (submitButton) submitButton.textContent = 'Sending...';

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData as unknown as Record<string, string>).toString(),
        });

        if (!response.ok) throw new Error('Form submission failed');

        form.classList.add('hidden');
        successPanel?.classList.remove('hidden');
        successPanel?.classList.add('flex');
      } catch (err) {
        errorBanner?.classList.remove('hidden');
        errorBanner?.classList.add('flex');
        submitButton?.removeAttribute('disabled');
        if (submitButton && originalLabel) submitButton.textContent = originalLabel;
      }
    });

    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('blur', () => {
        const name = (el as HTMLInputElement).name;
        if (validators[name]) {
          showFieldError(name, !validators[name]((el as HTMLInputElement).value));
        }
      });
    });
  }

  setupContactForm();
</script>
