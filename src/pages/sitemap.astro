---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import servicesData from '../data/services.json';
import cities from '../data/cities.json';

const services = servicesData.categories.flatMap((cat: any) =>
  cat.items.map((item: any) => ({ ...item, category: cat.name }))
);
const posts = await getCollection('blog');

const corePages = [
  { title: 'Home', href: '/' },
  { title: 'About', href: '/about' },
  { title: 'Blog', href: '/blog' },
  { title: 'FAQ', href: '/faq' },
  { title: 'Contact', href: '/contact' },
  { title: 'Disclaimer', href: '/disclaimer' },
  { title: 'Privacy Policy', href: '/privacy-policy' },
];
---

<BaseLayout
  title="Sitemap"
  description="A full overview of every page on the Astro Vikesh Kumar website, including services, locations and blog articles."
>
  <section class="border-b border-neutral-200 bg-neutral-50 py-12 lg:py-16">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold text-neutral-900 sm:text-4xl">Sitemap</h1>
      <p class="mt-4 max-w-2xl text-lg leading-7 text-neutral-600">
        A complete list of every page on this website.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-page grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent-700">Main Pages</h2>
        <ul class="mt-3 space-y-2 text-sm text-neutral-700">
          {corePages.map((page) => (
            <li><a href={page.href} class="hover:text-accent-700">{page.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent-700">Services</h2>
        <ul class="mt-3 space-y-2 text-sm text-neutral-700">
          {services.map((service: any) => (
            <li><a href={`/services/${service.slug}`} class="hover:text-accent-700">{service.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent-700">Locations</h2>
        <ul class="mt-3 space-y-2 text-sm text-neutral-700">
          {cities.map((city) => (
            <li><a href={`/locations/${city.slug}`} class="hover:text-accent-700">{city.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent-700">Blog Articles</h2>
        <ul class="mt-3 space-y-2 text-sm text-neutral-700">
          {posts.map((post) => (
            <li><a href={`/blog/${post.id}`} class="hover:text-accent-700">{post.data.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
