---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="Articles on astrology, spiritual remedies and everyday guidance from Astro Vikesh Kumar."
>
  <section class="border-b border-neutral-200 bg-neutral-50 py-12 lg:py-16">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold text-neutral-900 sm:text-4xl">Blog</h1>
      <p class="mt-4 max-w-2xl text-lg leading-7 text-neutral-600">
        Practical, plain-language articles on astrology and spiritual guidance.
      </p>
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-page grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="flex flex-col overflow-hidden rounded-xl border border-neutral-200 bg-surface shadow-soft">
          <a href={`/blog/${post.id}`}>
            <img
              src={post.data.image}
              alt={post.data.imageAlt}
              width="1200"
              height="675"
              class="h-44 w-full object-cover"
            />
          </a>
          <div class="flex flex-1 flex-col p-5">
            <time datetime={post.data.pubDate.toISOString()} class="text-xs font-medium uppercase tracking-wide text-accent-700">
              {dateFormatter.format(post.data.pubDate)}
            </time>
            <h2 class="mt-2 text-lg font-semibold text-neutral-900">
              <a href={`/blog/${post.id}`} class="hover:text-accent-700">{post.data.title}</a>
            </h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-neutral-600">{post.data.description}</p>
            <a href={`/blog/${post.id}`} class="mt-4 text-sm font-semibold text-accent-700 hover:text-accent-800">
              Read article
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
